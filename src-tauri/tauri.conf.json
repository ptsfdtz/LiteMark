{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LiteMark",
  "version": "2.1.5",
  "identifier": "com.ptsfdtz.LiteMark",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LiteMark",
        "width": 900,
        "height": 1200,
        "minWidth": 600,
        "minHeight": 600,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "base-uri": "'none'",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost",
        "font-src": "'self' data: blob: https://cdnjs.cloudflare.com https://cdn.jsdelivr.net",
        "form-action": "'none'",
        "frame-src": "'none'",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "object-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net",
        "worker-src": "'self'"
      },
      "devCsp": {
        "default-src": "'self' customprotocol: asset:",
        "base-uri": "'none'",
        "connect-src": "'self' ipc: http://ipc.localhost ws: asset: http://asset.localhost",
        "font-src": "'self' data: blob: https://cdnjs.cloudflare.com https://cdn.jsdelivr.net",
        "form-action": "'none'",
        "frame-src": "'none'",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "object-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net",
        "worker-src": "'self'"
      },
      "capabilities": ["dialog", "opener", "store", "updater", "window"],
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.svg"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "txt"],
        "name": "Markdown",
        "description": "Markdown Document",
        "role": "Editor"
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ptsfdtz/LiteMark/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1Qjk4MTE4OTYxNTJBNzQKUldSMEtoV1dHSUc1NWZrUWNrajQvWFZWbE5XM1IrcTg5bTkvZS9oeUFnRURnc1hHUUJ3VkNwNysK"
    }
  }
}
